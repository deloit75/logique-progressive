<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ metadata.title }} — Logique Progressive</title>
  <style>
    :root { font-family: system-ui, sans-serif; color: #23345b; background: #f5f7fc; }
    * { box-sizing: border-box; }
    body { margin: 0; }
    main { max-width: 820px; margin: 28px auto; padding: 30px; background: white; border-radius: 20px; box-shadow: 0 8px 30px #23345b12; }
    a { color: #293d79; }
    nav { margin-bottom: 28px; }
    h1 { margin: 10px 0; font-size: clamp(1.7rem, 4vw, 2.4rem); }
    .muted { color: #5b6983; line-height: 1.6; }
    .story { padding: 20px; background: #edf2ff; border-radius: 13px; line-height: 1.7; margin: 20px 0; }
    fieldset { border: 1px solid #dfe5f1; border-radius: 13px; padding: 18px; margin: 16px 0; }
    legend { padding: 0 6px; font-weight: 650; }
    .points { font-weight: 400; color: #697690; font-size: .88rem; }
    input[type=number], input[type=text] { padding: 10px 12px; font-size: 1rem; border: 1px solid #aebbd7; border-radius: 9px; max-width: 100%; }
    input[type=text] { width: 240px; }
    input[type=number] { width: 170px; }
    .choice { display: block; padding: 8px 2px; line-height: 1.4; }
    .choice input { margin-right: 9px; }
    button, .button { display: inline-block; padding: 12px 20px; background: #293d79; border: 0; color: white; border-radius: 10px; font-size: 1rem; text-decoration: none; cursor: pointer; }
    .button:hover, button:hover { background: #405ba0; }
    .error { padding: 14px; background: #fff3dc; border-radius: 10px; }
    .stars { color: #b57909; font-size: 2rem; letter-spacing: 3px; margin-bottom: 0; }
    .ok { color: #187044; }
    .miss { color: #a03831; }
    .result { border-bottom: 1px solid #e4e9f2; padding: 12px 0; line-height: 1.7; }
    .correction { background: #f0f8f2; padding: 20px; border-radius: 12px; }
    table { border-collapse: collapse; width: 100%; margin-top: 12px; background: white; }
    th, td { padding: 10px; text-align: left; border: 1px solid #dae2f3; }
    th { background: #e5ecff; }
    .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; align-items: center; }
    @media (max-width: 650px) { main { margin: 0; padding: 20px; border-radius: 0; } }
  </style>
</head>
<body>
<main>
  <nav><a href="{{ path('exercise_catalog') }}">← Tous les exercices</a></nav>
  <p class="muted">{{ metadata.level }} · {{ metadata.subject }} · {{ metadata.duration }} min environ</p>
  <h1>{{ metadata.icon }} {{ metadata.title }}</h1>
  <p class="muted"><strong>Objectif :</strong> {{ metadata.skill }}.</p>
  <div class="story">
    {{ story }}
    {% if table is not null %}
      <table>
        <caption>Nombre de livres empruntés par jour</caption>
        <thead><tr><th scope="col">Jour</th><th scope="col">Livres empruntés</th></tr></thead>
        <tbody>
          {% for day, number in table %}
            <tr><th scope="row">{{ day|capitalize }}</th><td>{{ number }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}
  </div>

  {% if error %}<p role="alert" class="error">{{ error }}</p>{% endif %}

  {% if results is null %}
    <form method="post" action="{{ path('exercise_play', {slug: slug}) }}">
      <input type="hidden" name="token" value="{{ token }}">
      {% for step in steps %}
        <fieldset>
          <legend>{{ loop.index }}. {{ step.question }} <span class="points">({{ step.weight }} {{ step.weight == 1 ? 'point' : 'points' }})</span></legend>
          {% if step.type == 'number' %}
            <label for="answer-{{ step.id }}">Ta réponse :</label>
            <input id="answer-{{ step.id }}" name="answers[{{ step.id }}]" type="number" step="1" min="0" required>
          {% elseif step.type == 'text' or step.type == 'time' %}
            <label for="answer-{{ step.id }}">Ta réponse :</label>
            <input id="answer-{{ step.id }}" name="answers[{{ step.id }}]" type="text" maxlength="40" autocomplete="off"{% if step.type == 'time' %} placeholder="ex. 09:25" inputmode="text"{% endif %} required>
          {% elseif step.type == 'choice' %}
            {% for value, label in step.choices %}
              <label class="choice"><input type="radio" name="answers[{{ step.id }}]" value="{{ value }}" required>{{ label }}</label>
            {% endfor %}
          {% endif %}
        </fieldset>
      {% endfor %}
      <button type="submit">Corriger mon exercice</button>
    </form>
  {% else %}
    <h2>Mon résultat</h2>
    <p class="stars" aria-label="{{ results.stars }} étoiles sur 5">{% for i in 1..5 %}{{ i <= results.stars ? '★' : '☆' }}{% endfor %}</p>
    <p><strong>{{ results.stars }}/5 étoiles</strong> — tu peux progresser à ton rythme.</p>

    <section class="correction" aria-label="Correction détaillée">
      <h2>Correction expliquée</h2>
      {% for step in steps %}
        {% set feedback = results.steps[step.id] %}
        <div class="result">
          <strong>{{ loop.index }}. {{ step.question }}</strong>
          <p class="{{ feedback.correct ? 'ok' : 'miss' }}">
            {{ feedback.correct ? 'Bonne réponse' : 'À revoir' }}
            — {{ feedback.points }}/{{ feedback.max }} point(s)
          </p>
          <p><strong>Réponse attendue :</strong> {{ feedback.expected }}</p>
          <p><strong>Explication :</strong> {{ feedback.explanation }}</p>
        </div>
      {% endfor %}
      <p><strong>Notion mobilisée :</strong> {{ metadata.skill }}.</p>
    </section>
    <div class="actions">
      <a class="button" href="{{ path('exercise_play', {slug: slug}) }}">Nouveau défi</a>
      <a href="{{ path('exercise_catalog') }}">Choisir un autre exercice</a>
    </div>
  {% endif %}

  <p class="muted">Prototype : aucune donnée personnelle enregistrée et aucun crédit de temps d’écran.</p>
</main>
</body>
</html>
